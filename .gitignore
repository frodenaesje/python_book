# Ignore everything except the tb_sc folder for initial mirror
/*
!.gitignore
!tb_sc/
!tb_sc/**

# Ignore tb_sc chapters 15 and above
/tb_sc/ch_1[5-9]_*
/tb_sc/ch_[2-9][0-9]_*
/tb_sc/ch_[1-9][0-9][0-9]_*

# Ignore tb_sc data and tools folders
/tb_sc/data/
/tb_sc/tools/

# Ignore tb_sc package experiment files by name
/tb_sc/**/for_test*.py
/tb_sc/**/rom_student*.py

# Never share root-level Python files
/*.py

# Ignore local and generated files
.venv/
.venv-1/
.pytest_cache/
.vscode/
__pycache__/
*.py[cod]
*.pkl
